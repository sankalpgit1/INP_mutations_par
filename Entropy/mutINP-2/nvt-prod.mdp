;define                  = -DPOSRES -DPOSRES_FC_BB=400.0 -DPOSRES_FC_SC=40.0
integrator              = md-vv
dt                      = 0.001
nsteps                  = 200000
nstxout-compressed      = 4
nstxout                 = 4
nstvout                 = 4 
nstcalcenergy           = 4
nstenergy               = 4
nstlog                  = 4
;
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
;
tcoupl                  = v-rescale
tc_grps                 = PROTEIN SOLV
tau_t                   = 1.0 1.0
ref_t                   = 260 260
;
;energygrps              = IW BW PROTEIN
constraints             = h-bonds
constraint_algorithm    = LINCS
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = PROTEIN SOLV
;
gen-vel                 = no
gen-temp                = 260
gen-seed                = -1

